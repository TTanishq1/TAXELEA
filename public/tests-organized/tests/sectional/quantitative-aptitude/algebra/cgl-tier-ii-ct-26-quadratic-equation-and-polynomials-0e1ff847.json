          "id": "D",
          "text": "\\(\\frac{(-4 \\sqrt{3}+1)}{4}\\)",
          "html": "<span class=\"math-tex\">\\(\\frac{(-4 \\sqrt{3}+1)}{4}\\)</span>"
        }
      ],
      "correctAnswer": "C",
      "solution": "<p><span class=\"math-tex\">\\(\\mathbf{x}+\\frac{1}{x}=\\frac{\\sqrt{3}+1}{2}\\)</span></p>\n\n<p><span style=\"\">on squaring&nbsp;<span class=\"math-tex\">\\(\\qquad\\left(x+\\frac{1}{x}\\right)^2=\\left(\\frac{\\sqrt{3}+1}{2}\\right)^2\\)</span></span></p>\n\n<p><span class=\"math-tex\">\\(\\mathbf{x}^2+\\frac{1}{x^2}+2=\\frac{3+1+2 \\sqrt{3}}{4} \\)</span></p>\n\n<p><span class=\"math-tex\">\\(\\mathbf{x}^2+\\frac{1}{x^2}=\\frac{4+2 \\sqrt{3}}{4}-2\\)</span></p>\n\n<p><span class=\"math-tex\">\\(\\mathbf{x}^2+\\frac{1}{x^2}=\\frac{\\sqrt{3}-2}{2}\\)</span></p>\n\n<p>on squaring again</p>\n\n<p><span class=\"math-tex\">\\(\\mathbf{x}^4+\\frac{1}{x^4}+2=\\frac{3+4-4 \\sqrt{3}}{4} \\)</span></p>\n\n<p><span class=\"math-tex\">\\(\\mathbf{x}^4+\\frac{1}{x^4}=\\frac{7-4 \\sqrt{3}}{4}-2\\)</span></p>\n\n<p><span class=\"math-tex\">\\(\\mathbf{x}^4+\\frac{1}{x^4}=\\frac{-4 \\sqrt{3-1}}{4}\\)</span></p>\n",
