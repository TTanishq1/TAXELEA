      "questionHtml": "If,&nbsp;<span class=\"math-tex\">\\(\\frac{r}{13} + \\frac{13}{r} = 1\\)</span>&nbsp;then the value of r<sup>3</sup>&nbsp;is:",
      "options": [
        {
          "id": "A",
