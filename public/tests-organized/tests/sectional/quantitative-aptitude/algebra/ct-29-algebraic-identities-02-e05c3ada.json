      "question": "Simplify the given expression. \\(\\frac{(326+222)^2-(326-222)^2}{(326\\times222)}\\)",
      "questionHtml": "<p>Simplify the given expression.&nbsp;</p>\n\n<p><span class=\"math-tex\">\\(\\frac{(326+222)^2-(326-222)^2}{(326\\times222)}\\)</span></p>\n",
      "options": [
        {
          "id": "A",
          "text": "1",
          "html": "1"
        },
        {
          "id": "B",
          "text": "4",
          "html": "4"
        },
        {
          "id": "C",
          "text": "3",
          "html": "3"
        },
        {
          "id": "D",
          "text": "2",
          "html": "2"
        }
      ],
      "correctAnswer": "B",
      "solution": "<span class=\"math-tex\">\\(\\frac{(326+222)^2-(326-222)^2}{(326×222)}\\)</span> <span style=\"color: rgb(33, 37, 41);\">⇒ (4 × </span><span style=\"color: rgb(33, 37, 41);\">326 × 222)</span><span style=\"color: rgb(33, 37, 41);\">/(326 × 222) = 4</span>",
