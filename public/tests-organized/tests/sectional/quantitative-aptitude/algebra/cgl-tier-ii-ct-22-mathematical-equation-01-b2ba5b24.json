      "question": "Interchanging the places of which two numbers in the given equation will make the equation balanced? 7 &times; 10 &divide; 6 + 3 - 2 = 10",
      "questionHtml": "<p><font style=\"vertical-align: inherit;\"><font style=\"vertical-align: inherit;\">Interchanging the places of which two numbers in the given equation will make the equation balanced?</font></font></p>\n\n<p><font style=\"vertical-align: inherit;\"><font style=\"vertical-align: inherit;\">7&nbsp;&times; 10&nbsp;&divide; 6 + 3 - 2 = 10</font></font></p>\n",
      "options": [
        {
          "id": "A",
          "text": "6, 10",
          "html": "<span style=\"\"><font style=\"vertical-align: inherit;\"><font style=\"vertical-align: inherit;\">6, 10</font></font></span>"
        },
        {
