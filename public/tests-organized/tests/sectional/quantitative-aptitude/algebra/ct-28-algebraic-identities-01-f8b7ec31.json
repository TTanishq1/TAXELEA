    {
      "id": "f8b7ec316575-q1",
      "number": 1,
      "question": "The value of \\({(281 + 119)^2 - (281 - 119)^2} \\over 281 \\times 119\\) is equal to which of the following?",
      "questionHtml": "<span style=\"\">The value of&nbsp;</span><span class=\"math-tex\">\\({(281 + 119)^2 - (281 - 119)^2} \\over 281 \\times 119\\)</span>&nbsp;is equal to which of the following?",
      "options": [
        {
          "id": "A",
