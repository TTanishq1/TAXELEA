          "text": "4",
          "html": "4"
        },
        {
          "id": "D",
          "text": "2",
          "html": "2"
        }
      ],
      "correctAnswer": "C",
      "solution": "<span class=\"math-tex\">\\(\\dfrac{(281 + 119)^2 - (281 - 119)^2}{ 281 \\times 119}\\)</span> <span style=\"color: rgb(33, 37, 41);\">⇒ </span><span class=\"math-tex\">\\(\\dfrac{4\\times 281\\times 119}{281\\times 119}\\)</span> <span style=\"color: rgb(33, 37, 41);\">⇒ 4</span>",
