      ],
      "correctAnswer": "B",
      "solution": "<p style=\"color: rgb(33, 37, 41);\"><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\"> (Side)</span><span style=\"font-family: var(--bs-body-font-family); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align); position: relative; line-height: 0; vertical-align: baseline; top: -0.5em; font-size: 10.5px;\">2</span><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\"> = 5</span><span style=\"font-family: var(--bs-body-font-family); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align); position: relative; line-height: 0; vertical-align: baseline; top: -0.5em; font-size: 10.5px;\">2</span><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\"> + 12</span><span style=\"font-family: var(--bs-body-font-family); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align); position: relative; line-height: 0; vertical-align: baseline; top: -0.5em; font-size: 10.5px;\">2</span> ⇒ (Side)<span style=\"position: relative; line-height: 0; vertical-align: baseline; top: -0.5em; font-size:10.5px;\">2</span> = 25 + 144 ⇒ (Side)<span style=\"position: relative; line-height: 0; vertical-align: baseline; top: -0.5em; font-size:10.5px;\">2 </span> = 169 ⇒ Side = 13</p>\n\n<p style=\"color: rgb(33, 37, 41);\">Perimeter = Sum of all sides  ⇒ 4a = 4 × 13 = 52</p>\n",
