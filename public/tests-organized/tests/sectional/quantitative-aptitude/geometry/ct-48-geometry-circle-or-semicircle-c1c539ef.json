  "questions": [
    {
      "id": "c1c539efdb46-q1",
      "number": 1,
      "question": "Chord AB of a circle with radius 5 cm is at a distance of 4 cm from the centre O. If tangents drawn at A and B intersect at P, then find the length of the tangent AP.",
      "questionHtml": "Chord AB of a circle with radius 5 cm is at a distance of 4 cm from the centre O. If tangents drawn at A and B intersect at P, then find the length of the tangent AP.",
      "options": [
        {
          "id": "A",
          "text": "7.5 cm",
          "html": "7.5 cm"
        },
        {
          "id": "B",
          "text": "3 cm",
          "html": "3 cm"
        },
        {
          "id": "C",
          "text": "3.75 cm",
          "html": "3.75 cm"
        },
        {
          "id": "D",
          "text": "2.4 cm",
          "html": "2.4 cm"
        }
      ],
      "correctAnswer": "C",
      "solution": "<p><img alt=\"\" src=\"https://storage.googleapis.com/tb-img/production/22/02/F1_Arun%20K_Shraddha_28.02.2022_D2.png\" style=\"width: 318px; height: 285px;\" /></p>\n\n<p><strong>Given</strong></p>\n\n<p>Radius of circle = 5 cm</p>\n\n<p>Distance of chord from the centre = 4 cm</p>\n\n<p><strong>THEOREM</strong></p>\n\n<p>The perpendicular to a chord bisects the chord, if drawn from the centre of the circle.</p>\n\n<p><strong>Concept</strong></p>\n\n<p>In ∆AOI</p>\n\n<p>OA<sup>2</sup> = OI<sup>2</sup> + AI<sup>2</sup>&nbsp;(By pythagorus theorem)</p>\n\n<p>(5)<sup>2</sup> = (4)<sup>2</sup> + AI<sup>2</sup></p>\n\n<p>25 = 16 + AI<sup>2</sup></p>\n\n<p>25 - 16 = AI<sup>2</sup></p>\n\n<p>9 = AI<sup>2</sup></p>\n\n<p>3 = AI</p>\n\n<p>∆OAI and ∆ API&nbsp;are similar triangles</p>\n\n<p><span class=\"math-tex\">\\(OA\\over OI\\)</span>&nbsp;=&nbsp;<span class=\"math-tex\">\\(AP\\over AI\\)</span></p>\n\n<p>&rArr;&nbsp;<span class=\"math-tex\">\\(5\\over 4\\)</span>&nbsp;=&nbsp;<span class=\"math-tex\">\\(AP\\over 3\\)</span></p>\n\n<p>&rArr;&nbsp;<span class=\"math-tex\">\\(( 5 \\times 3)\\over 4\\)</span>&nbsp;=&nbsp;<span class=\"math-tex\">\\(AP\\)</span></p>\n\n<p>AP = 3.75 cm</p>\n\n<p><strong>&there4; The length of the tangent AP is 3.75 cm</strong></p>\n",
      "images": [
        "https://storage.googleapis.com/tb-img/production/22/02/F1_Arun%20K_Shraddha_28.02.2022_D2.png"
      ],
      "subject": null,
      "topic": null,
      "difficulty": null
    },
