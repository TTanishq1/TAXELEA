          "html": "<span class=\"math-tex\">\\(8\\sqrt3\\)</span>&nbsp;cm"
        },
        {
          "id": "B",
          "text": "\\(\\sqrt 3\\) cm",
          "html": "<span class=\"math-tex\">\\(\\sqrt 3\\)</span>&nbsp;<span style=\"\">cm</span>"
        },
        {
          "id": "C",
          "text": "\\(2\\sqrt3\\) cm",
          "html": "<span class=\"math-tex\">\\(2\\sqrt3\\)</span>&nbsp;<span style=\"\">cm</span>"
        },
        {
          "id": "D",
          "text": "\\(4\\sqrt3\\) cm",
          "html": "<span class=\"math-tex\">\\(4\\sqrt3\\)</span>&nbsp;<span style=\"\">cm</span>"
        }
      ],
      "correctAnswer": "A",
      "solution": "<p style=\"\"><img alt=\"\" src=\"https://storage.googleapis.com/tb-img/production/22/03/F1_ArunK_Madhuri_11.03.2022_D6.png\" style=\"height: 177px; width: 194px;\" /></p>\n\n<p style=\"\">AD = DB,  O<span style=\"line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\">1</span>O<span style=\"line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\">2</span> = 8</p>\n\n<p style=\"\">Again O<span style=\"line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\">1</span>A = O<span style=\"line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\">2</span>A = 8</p>\n\n<p style=\"\">∠ADO<span style=\"line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\">1</span> = 90°, O<span style=\"line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\">1</span>D = O<span style=\"line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em;font-size:10.5px;\">2</span>D = 4, AD = √(64 - 16) ⇒ √48 = 4√3</p>\n\n<p style=\"\">AB = 2 × 4√3 = 8√3</p>\n",
      "images": [
        "https://storage.googleapis.com/tb-img/production/22/03/F1_ArunK_Madhuri_11.03.2022_D6.png"
      ],
