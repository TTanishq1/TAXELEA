    {
      "id": "c1c539efdb46-q3",
      "number": 3,
      "question": "In a circle with centre O and diameter EF, if the two chords AE = AF, then m&ang;AEF is:",
      "questionHtml": "In a circle with centre O and diameter EF, if the two chords AE&nbsp;= AF, then m&ang;AEF is:",
      "options": [
        {
          "id": "A",
          "text": "80&deg;",
          "html": "80&deg;"
        },
        {
          "id": "B",
          "text": "90&deg;",
          "html": "90&deg;"
        },
        {
          "id": "C",
          "text": "45&deg;",
          "html": "45&deg;"
        },
        {
          "id": "D",
          "text": "60&deg;",
          "html": "60&deg;"
        }
      ],
      "correctAnswer": "C",
      "solution": "<img alt=\"\" src=\"https://storage.googleapis.com/tb-img/production/24/02/F2_SSC_Arbaz_22-2-24_D1.png\" style=\"color: rgb(33, 37, 41); width: 143px; height: 162px;\" />\n<p style=\"color: rgb(33, 37, 41);\">∠EFA = ∠FEA [ AE = AF]</p>\n\n<p style=\"color: rgb(33, 37, 41);\">And as we know, ∠EFA = 90° </p>\n\n<p style=\"color: rgb(33, 37, 41);\">So,  m∠AEF =</p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ 90 / 2 = 45° </p>\n",
      "images": [
        "https://storage.googleapis.com/tb-img/production/24/02/F2_SSC_Arbaz_22-2-24_D1.png"
