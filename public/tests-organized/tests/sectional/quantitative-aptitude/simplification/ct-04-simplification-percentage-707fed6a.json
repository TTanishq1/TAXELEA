        "https://chat.google.com/u/0/api/get_attachment_url?url_type=FIFE_URL&amp;content_type=image%2Fpng&amp;attachment_token=AAUuIGuhBy1E5lQTPZYP7SdKkTuyRgc4djqJbT8KcC98G5Oe18%2FsI%2BD3Ij83iuqEkjmOB9rm49NR%2BUJ2oIPBipMEcBP%2BELehSPkPTJYGqYnVtAnWCMJCcEe%2FMvXXe869wfBhKzRRAZcUFFO0Sy4ENss%2BI55iQTBeuE6VZG9YlCCeWGoVnVPxK3eZwAMYaBen21zZtsbH%2BiZFoW0HrN%2Fm%2BIUux2%2B678LWnUPZtCK4o1SearcGIukDDyd9JeCFMgXXA1sKMKIlbFYFDiv2JYQvDCpcWjKGUH1I5kX9ECpVn8e7l%2BSXo1dlFbPGnDi8bmsyOZTxAkZAXL63%2FE6rrY3rpLec%2BPWmOSqrJCN4QusgLGoli3QkGYto3c%2B7bWvr%2Fim8T8bQvf8Dz%2Bp7sGTc%2BwAwEIUlrIzMRWyjJ0w%2FXSIglf8Iu082pRGRQpUrFi7Ai5PjAe2yIDJ2NrNVc6uthIQiqODgzWgvZK5QfHy5kHYLYx4hJOvVcdUCv95vO9tCK8R6jvqcvvogialS47laGff5fFHp3Q%3D%3D&amp;sz=w512"
