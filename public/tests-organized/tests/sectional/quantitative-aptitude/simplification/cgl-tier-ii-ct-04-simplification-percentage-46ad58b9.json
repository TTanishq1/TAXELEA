    {
      "id": "46ad58b97f16-q1",
      "number": 1,
      "question": "If 200% of k - (k + 2)% of 50 = k, then what is the value of k?",
      "questionHtml": "If 200% of k - (k + 2)% of 50 = k, then what is the value of k?",
      "options": [
        {
          "id": "A",
          "text": "\\(\\frac{2}{3}\\)",
          "html": "<span class=\"math-tex\">\\(\\frac{2}{3}\\)</span>"
        },
        {
          "id": "B",
          "text": "\\(\\frac{100}{149}\\)",
          "html": "<span class=\"math-tex\">\\(\\frac{100}{149}\\)</span>"
        },
        {
          "id": "C",
          "text": "2",
          "html": "2"
        },
        {
          "id": "D",
          "text": "1",
          "html": "1"
        }
      ],
      "correctAnswer": "C",
      "solution": "<p style=\"color: rgb(33, 37, 41);\">⇒ <span class=\"math-tex\">\\(\\dfrac{200}{100}\\)</span> × k - <span class=\"math-tex\">\\(\\dfrac{(k + 2)}{100}\\)</span> × 50 = k</p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ 2k - (k + 2)/2 = k</p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ 4k - k - 2 = 2k</p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ 4k - 2k - k = 2</p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ 4k - 3k = 2</p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ k = 2</p>\n",
      "images": [],
      "subject": null,
      "topic": null,
      "difficulty": null
    },
    {
