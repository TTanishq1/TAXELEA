      "question": "\\({\\rm{Simplify}}\\,\\frac{{\\sqrt 5 \\, - \\,\\sqrt 3 }}{{\\sqrt 5 \\, + \\,\\sqrt 3 }}\\, - \\,\\frac{{\\sqrt 5 \\, + \\,\\sqrt 3 }}{{\\sqrt 5 \\, - \\,\\sqrt 3 }}:\\)",
      "questionHtml": "<span class=\"math-tex\">\\({\\rm{Simplify}}\\,\\frac{{\\sqrt 5 \\, - \\,\\sqrt 3 }}{{\\sqrt 5 \\, + \\,\\sqrt 3 }}\\, - \\,\\frac{{\\sqrt 5 \\, + \\,\\sqrt 3 }}{{\\sqrt 5 \\, - \\,\\sqrt 3 }}:\\)</span>",
      "options": [
        {
          "id": "A",
          "text": "\\(- 2\\sqrt {15} \\)",
          "html": "<span class=\"math-tex\">\\(- 2\\sqrt {15} \\)</span>"
        },
        {
          "id": "B",
          "text": "\\( - \\frac{{17}}{4}\\)",
          "html": "<span class=\"math-tex\">\\( - \\frac{{17}}{4}\\)</span>"
        },
        {
          "id": "C",
          "text": "-1",
          "html": "-1"
        },
        {
          "id": "D",
          "text": "\\(2\\sqrt {15} \\)",
          "html": "<span class=\"math-tex\">\\(2\\sqrt {15} \\)</span>"
        }
      ],
      "correctAnswer": "A",
      "solution": "<p style=\"color: rgb(33, 37, 41);\"> <span class=\"math-tex\">\\(\\frac{{\\sqrt 5 \\, - \\,\\sqrt 3 }}{{\\sqrt 5 \\, + \\,\\sqrt 3 }}\\, - \\,\\frac{{\\sqrt 5 \\, + \\,\\sqrt 3 }}{{\\sqrt 5 \\, - \\,\\sqrt 3 }}:\\)</span></p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ <span class=\"math-tex\">\\((\\sqrt5-\\sqrt3)^2 -(\\sqrt5+\\sqrt3)^2\\over(\\sqrt5)^2 - (\\sqrt3)^2\\)</span> <span style=\"color: rgb(33, 37, 41);\">⇒ </span><span class=\"math-tex\">\\(5 + 3 -2\\sqrt15-5-3-2\\sqrt15\\over5-3\\)</span><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\"> </span><span style=\"color: rgb(33, 37, 41);\">⇒ </span><span class=\"math-tex\">\\(-4\\sqrt15\\over2\\)</span><span style=\"color: rgb(33, 37, 41);\"> =</span><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\"> <span class=\"math-tex\">\\(- 2\\sqrt {15} \\)</span></span></p>\n",
