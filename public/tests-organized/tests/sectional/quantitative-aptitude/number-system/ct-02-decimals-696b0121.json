        },
        {
          "id": "C",
          "text": "202.05",
          "html": "202.05"
        },
        {
          "id": "D",
          "text": "2002.5",
          "html": "2002.5"
        }
      ],
      "correctAnswer": "C",
      "solution": "<p><strong>Given:</strong></p>\n\n<p><span style=\"\">(12.3&nbsp;&divide; 0.03)&nbsp;&divide; 2.05 + 2.05</span></p>\n\n<p><strong>Concept used:</strong></p>\n\n<p><img alt=\"\" src=\"https://storage.googleapis.com/tb-img/production/22/07/Bodmas%20dtp.png\" style=\"width: 440px; height: 247px;\" /></p>\n\n<p><strong>Calculation:</strong></p>\n\n<p><span style=\"\">(12.3&nbsp;&divide; 0.03)&nbsp;&divide; 2.05 + 2.05</span></p>\n\n<p><span style=\"\">&rArr;&nbsp;<span class=\"math-tex\">\\((\\frac{123}{10} ÷ \\frac{3}{100}) ÷ 2.05 + 2.05\\)</span></span></p>\n\n<p><span style=\"\">&rArr;&nbsp;</span><span class=\"math-tex\">\\((\\frac{123}{10} \\times \\frac{100}{3}) ÷ 2.05 + 2.05\\)</span></p>\n\n<p><span style=\"\">&rArr;&nbsp;</span><span class=\"math-tex\">\\(410 ÷ \\frac{205}{100} + 2.05\\)</span></p>\n\n<p><span style=\"\">&rArr;&nbsp;</span><span class=\"math-tex\">\\(410 \\times \\frac{100}{205} + 2.05\\)</span></p>\n\n<p><span style=\"\">&rArr;&nbsp;</span>200 + 2.05</p>\n\n<p>&rArr; 202.05</p>\n\n<p><strong>&there4; Required answer is 202.05.</strong></p>\n",
      "images": [
        "https://storage.googleapis.com/tb-img/production/22/07/Bodmas%20dtp.png"
      ],
