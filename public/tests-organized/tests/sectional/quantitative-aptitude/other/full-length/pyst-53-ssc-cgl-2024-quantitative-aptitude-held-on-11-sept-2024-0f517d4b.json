    {
      "id": "0f517d4b7ab8-q2",
      "number": 2,
      "question": "The salary of a worker is first increased by 25%, then it is decreased by 12%. The percentage change in his salary is:",
      "questionHtml": "The salary of a worker is first increased by 25%, then it is decreased by 12%. The percentage change in his salary is:",
      "options": [
        {
          "id": "A",
          "text": "10% increase",
          "html": "10% increase"
        },
        {
          "id": "B",
          "text": "13% increase",
          "html": "13% increase"
        },
        {
          "id": "C",
          "text": "10% decrease",
          "html": "10% decrease"
        },
        {
          "id": "D",
          "text": "13% decrease",
          "html": "13% decrease"
        }
      ],
      "correctAnswer": "A",
      "solution": "<p><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\">Initial salary = 100 units</span></p>\n\n<p><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\">New Salary after 25% increase = 100 + 25 = 125 units</span></p>\n\n<p><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\">Final Salary after 12% decrease = 125 - 15 = 110 units</span></p>\n\n<p><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\">Percentage Change = (110 - 100) / 100 × 100 = 10% increase</span></p>\n",
