      "difficulty": null
    },
    {
      "id": "0f517d4b7ab8-q13",
      "number": 13,
      "question": "If the ratio of the areas of two similar triangles is 25 : 144, the ratio of their corresponding sides is:",
      "questionHtml": "If the ratio of the areas of two similar triangles is 25 : 144, the ratio of their corresponding sides is:",
      "options": [
        {
          "id": "A",
          "text": "5 : 12",
          "html": "5 : 12"
        },
        {
          "id": "B",
          "text": "5 : 144",
          "html": "5 : 144"
        },
        {
          "id": "C",
          "text": "25 : 12",
          "html": "25 : 12"
        },
        {
          "id": "D",
          "text": "12 : 5",
          "html": "12 : 5"
        }
      ],
      "correctAnswer": "A",
      "solution": "<p>(x/y)<sup>2</sup> = 25/144</p>\n\n<p><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\">x/y = √(25/144)</span></p>\n\n<p><span style=\"font-family: var(--bs-body-font-family); font-size: var(--bs-body-font-size); font-weight: var(--bs-body-font-weight); text-align: var(--bs-body-text-align);\">x/y = 5/12</span></p>\n\n<p><span style=\"font-weight: bolder;\">The ratio of their corresponding sides is 5 : 12.</span></p>\n",
      "images": [],
