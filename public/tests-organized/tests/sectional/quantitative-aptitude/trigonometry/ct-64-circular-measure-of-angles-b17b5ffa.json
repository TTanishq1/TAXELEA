      "question": "What is the value of cosec 3&pi;/4?",
      "questionHtml": "What is the value of cosec 3&pi;/4?",
      "options": [
        {
          "id": "A",
          "text": "-&radic;2",
          "html": "-&radic;2"
        },
        {
          "id": "B",
          "text": "&radic;2",
          "html": "&radic;2"
        },
        {
          "id": "C",
          "text": "2/&radic;3",
          "html": "2/&radic;3"
        },
        {
          "id": "D",
          "text": "-2/&radic;3",
          "html": "-2/&radic;3"
        }
      ],
      "correctAnswer": "B",
      "solution": "<p style=\"\"><span style=\"font-weight: 700;\">Concept Used:</span></p>\n\n<ul style=\"\">\n\t<li>(&pi; -&theta;) is lying in the second quadrant so for the second quadrant sin and cosec will be taken as positive</li>\n</ul>\n\n<p style=\"\">&rArr; cosec (&pi; -&theta;) = cosec&nbsp;&theta;</p>\n\n<p style=\"\"><span style=\"font-weight: 700;\">Calculation:&nbsp;</span></p>\n\n<p style=\"\">∵&nbsp;cosec 3&pi;/4 = cosec (&pi; - &pi;/4) =&nbsp;cosec (&pi;/4)</p>\n\n<p style=\"\">(∵ Second Quadrant: cosec is positive)</p>\n\n<p style=\"\"><span style=\"font-weight: 700;\">&there4; cosec 3&pi;/4 = &radic;2</span></p>\n",
      "images": [],
      "subject": null,
      "topic": null,
      "difficulty": null
    },
