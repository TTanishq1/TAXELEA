          "html": "2"
        }
      ],
      "correctAnswer": "C",
      "solution": "<p style=\"\"><strong style=\"\">Given</strong><strong style=\"\">:</strong></p>\n\n<p style=\"\">tan0&deg; tan1&deg; tan2&deg; tan3&deg; tan4&deg; &hellip;&hellip; tan89&deg;</p>\n\n<p style=\"\"><strong style=\"\">Formula:</strong></p>\n\n<p style=\"\">tan 0&deg; = 0</p>\n\n<p style=\"\"><strong style=\"\">Calculation:</strong></p>\n\n<p style=\"\">tan0&deg; &times; tan1&deg; &times; tan2&deg; &times; &hellip;&hellip;. &times; tan89&deg;</p>\n\n<p style=\"\">&rArr; 0 &times; tan1&deg; &times; tan2&deg; &times; &hellip;&hellip;. &times; tan89&deg;</p>\n\n<p style=\"\">&rArr; 0</p>\n",
