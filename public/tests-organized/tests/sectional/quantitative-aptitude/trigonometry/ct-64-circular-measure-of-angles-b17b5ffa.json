      "question": "What is the value of the expression? (tan0&deg; tan1&deg; tan2&deg; tan3&deg; tan4&deg; &hellip;&hellip; tan89&deg;)",
      "questionHtml": "<p style=\"\">What is the value of the expression?</p>\n\n<p>(tan0&deg; tan1&deg; tan2&deg; tan3&deg; tan4&deg; &hellip;&hellip; tan89&deg;)</p>\n",
      "options": [
        {
          "id": "A",
          "text": "1",
