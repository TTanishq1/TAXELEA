          "html": "4"
        },
        {
          "id": "D",
          "text": "-2",
          "html": "-2"
        }
      ],
      "correctAnswer": "A",
      "solution": "<p><span class=\"math-tex\">\\(\\frac{{{{\\tan }^2}60^\\circ + {{\\cot }^2}30^\\circ }}{{{{\\tan }^2}20^\\circ - {{\\sec }^2}20^\\circ }} - \\frac{{\\sin 90^\\circ + \\cos 0^\\circ }}{{\\cos e{c^2}20^\\circ - {{\\cot }^2}20^\\circ }}\\)</span></p>\n\n<p><span style=\"color: rgb(33, 37, 41);\">⇒ (√3<sup>2</sup> + √3<sup>2</sup>)/(-1) - (1 + 1)/1 ⇒ - 6 - 2 = - 8</span></p>\n",
