      ],
      "correctAnswer": "B",
      "solution": "<p><b>Given:</b></p>\n\n<p>The given expression is tan 8&theta;&nbsp;= cot 2&theta;&nbsp;</p>\n\n<p><strong>Formula Used:</strong></p>\n\n<p>cot &theta;&nbsp;= tan(90&deg; -&nbsp;&theta;)</p>\n\n<p><b>Calculation:</b></p>\n\n<p>We have,</p>\n\n<p>&rArr; tan 8&theta; = cot 2&theta;&nbsp;</p>\n\n<p>&rArr; tan 8&theta; = tan(90&deg; - 2&theta;)</p>\n\n<p>&rArr; 8&theta; = 90&deg; - 2&theta;&nbsp;</p>\n\n<p>&rArr; 8&theta; + 2&theta; = 90&deg;</p>\n\n<p>&rArr; 10&theta; = 90&deg;</p>\n\n<p>&rArr;&nbsp;&theta; = 9&deg;</p>\n\n<p>&rArr; tan5&theta; = tan 5 &times; 9&deg; = tan45&deg;</p>\n\n<p>&rArr; tan45&deg; = 1</p>\n\n<p><strong>&there4; <span style=\"\">If tan 8&theta; = cot 2&theta;, where 0 &lt; 8&theta; &lt;&nbsp;</span><span class=\"math-tex\">\\(\\frac{\\pi}{2}\\)</span><span style=\"\">, then&nbsp;the value of tan 5&theta; is 1.</span>&nbsp;</strong></p>\n",
      "images": [],
      "subject": null,
      "topic": null,
      "difficulty": null
    },
