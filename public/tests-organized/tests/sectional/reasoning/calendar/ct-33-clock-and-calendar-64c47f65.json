    {
      "id": "64c47f659333-q8",
      "number": 8,
      "question": "If 5th January 2011 was a Thursday, then what day of the week was it on 1st January 2013?",
      "questionHtml": "If 5th January 2011 was a Thursday, then what day of the week was it on 1st January 2013?",
      "options": [
        {
          "id": "A",
          "text": "Thursday",
          "html": "Thursday"
        },
        {
          "id": "B",
          "text": "Wednesday",
          "html": "Wednesday"
        },
        {
          "id": "C",
          "text": "Tuesday",
          "html": "Tuesday"
        },
        {
          "id": "D",
          "text": "Monday",
          "html": "Monday"
        }
      ],
      "correctAnswer": "B",
      "solution": "<p> <span style=\"\">5</span><span style=\" line-height: 0; position: relative; vertical-align: baseline; top: -0.5em; font-size:10.5px;\">th </span><span style=\"\">January 2011 = Thursday.</span></p>\n\n<p><span style=\"\">And. 5</span><span style=\" line-height: 0; position: relative; vertical-align: baseline; top: -0.5em; font-size:10.5px;\">th </span><span style=\"\">January 2011 to 1</span><span style=\" line-height: 0; position: relative; vertical-align: baseline; top: -0.5em; font-size:10.5px;\">st </span><span style=\"\">January 2013 = 727 days(2012 is a leap year having 366 days).</span></p>\n\n<p><span style=\"\">⇒ 727 days = 103 weak and 6 odd days.</span></p>\n\n<p><span style=\"\">⇒ 1</span><span style=\" line-height: 0; position: relative; vertical-align: baseline; top: -0.5em; font-size:10.5px;\">st </span><span style=\"\">January 2013 = Thursday - 6 = Wednesday.</span></p>\n\n<p><span style=\"\">Hence, </span><span style=\"font-weight: 700; \">\"Wednesday\"</span><span style=\"\"> is the correct answer.</span></p>\n",
