    {
      "id": "1df424c8cf96-q7",
      "number": 7,
      "question": "Assume that the characters in each set follow a similar pattern, find the missing character.",
      "questionHtml": "<p>Assume that the characters in each set follow a similar pattern, find the missing character.</p>\n\n<p><img alt=\"\" src=\"https://storage.googleapis.com/tb-img/production/23/10/F1_Vinanti_Defence_18.10.23_D39.png\" style=\"width: 292px; height: 88px;\" /></p>\n",
      "options": [
        {
          "id": "A",
          "text": "32",
          "html": "32"
        },
        {
          "id": "B",
          "text": "36",
