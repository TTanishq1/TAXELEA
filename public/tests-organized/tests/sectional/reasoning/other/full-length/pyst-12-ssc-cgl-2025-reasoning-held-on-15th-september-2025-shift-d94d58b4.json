      "id": "d94d58b42ae9-q14",
      "number": 14,
      "question": "In a row of 60 students, Meena is 25th from the left and Rupa is 20th from the right. How many students are there between them?",
      "questionHtml": "In a row of 60 students, Meena is 25th from the left and Rupa is 20th from the right. How many students are there between them?",
      "options": [
        {
          "id": "A",
          "text": "11",
          "html": "11"
        },
        {
          "id": "B",
          "text": "10",
          "html": "10"
        },
        {
          "id": "C",
          "text": "12",
          "html": "12"
        },
        {
          "id": "D",
          "text": "15",
          "html": "15"
        }
      ],
      "correctAnswer": "D",
      "solution": "<p dir=\"ltr\" style=\"margin-top: 0.25pt; margin-bottom: 0pt; line-height: 1.2;\">Meena's position from  left = 25<br />\n </p>\n\n<p dir=\"ltr\" style=\"margin-top: 0.25pt; margin-bottom: 0pt; line-height: 1.2;\">Rupa's position from right = 20<br />\n </p>\n\n<p dir=\"ltr\" style=\"margin-top: 0.25pt; margin-bottom: 0pt; line-height: 1.2;\">Rupa’s position from left = (60 − 20) + 1 = 40 + 1 = 41</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0.25pt; margin-bottom: 0pt; line-height: 1.2;\"><br />\nSo, number of students between Meena and Rupa = (41 - 25) - 1 = 16 - 1 = 15</p>\n",
      "images": [],
      "subject": null,
      "topic": null,
      "difficulty": null
    },
