      "id": "56498de5c284-q13",
      "number": 13,
      "question": "The 6th term of a geometric progression (GP) is 48. The first term is 1.5. What is the common ratio (CR)?",
      "questionHtml": "The 6th term of a geometric progression (GP) is 48. The first term is 1.5. What is the common ratio (CR)?",
      "options": [
        {
          "id": "A",
          "text": "2.0",
          "html": "2.0"
        },
        {
          "id": "B",
          "text": "3.0",
          "html": "3.0"
        },
        {
          "id": "C",
          "text": "2.5",
          "html": "2.5"
        },
        {
          "id": "D",
          "text": "2.2",
          "html": "2.2"
        }
      ],
      "correctAnswer": "A",
      "solution": "<p>6th term = a × r<sup>(6-1)</sup></p>\n\n<p>48 = 1.5 × r<sup>5</sup></p>\n\n<p>r = (48 ÷ 1.5)<sup>1/5</sup> = 32<sup>1/5</sup> = 2.0</p>\n",
      "images": [],
      "subject": null,
      "topic": null,
      "difficulty": null
    },
