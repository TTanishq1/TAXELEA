      "id": "fd3aaf105dfd-q13",
      "number": 13,
      "question": "In a row of 45 students, Aman is 21st from the left end. What is his position from the right end?",
      "questionHtml": "<p>In a row of 45 students, Aman is 21st from the left end. What is his position from the right end?</p>\n",
      "options": [
        {
          "id": "A",
          "text": "24th",
          "html": "<p>24th</p>\n"
        },
        {
          "id": "B",
          "text": "25th",
          "html": "<p>25th</p>\n"
        },
        {
          "id": "C",
          "text": "26th",
          "html": "<p>26th</p>\n"
        },
        {
          "id": "D",
          "text": "27th",
          "html": "<p>27th</p>\n"
        }
      ],
      "correctAnswer": "B",
      "solution": "<p style=\"color: rgb(33, 37, 41);\">Aman is 21st from the left end.</p>\n\n<p style=\"color: rgb(33, 37, 41);\">Position from right = Total number of students – Position form left + 1</p>\n\n<p style=\"color: rgb(33, 37, 41);\">Position form right = 45 - 21 + 1 = 25</p>\n\n<p style=\"color: rgb(33, 37, 41);\">So, Aman’s position from the right end is 25th.</p>\n",
      "images": [],
      "subject": null,
      "topic": null,
      "difficulty": null
    },
