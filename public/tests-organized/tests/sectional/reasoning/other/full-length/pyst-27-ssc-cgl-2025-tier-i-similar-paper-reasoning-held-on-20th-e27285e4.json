      "id": "e27285e46b9e-q2",
      "number": 2,
      "question": "Find the signs to be interchanged. 20 / 5 + 10 - 4 &times; 2 = 38?",
      "questionHtml": "Find the signs to be interchanged.<br />\n<br />\n20 / 5 + 10 - 4 &times; 2 = 38?",
      "options": [
        {
          "id": "A",
          "text": "/ and -",
          "html": "/ and -"
        },
        {
          "id": "B",
          "text": "+ and &times;",
          "html": "+ and &times;"
        },
        {
          "id": "C",
          "text": "&times; and /",
          "html": "&times; and /"
        },
        {
          "id": "D",
          "text": "- and &times;",
          "html": "- and &times;"
        }
      ],
      "correctAnswer": "B",
      "solution": "<p style=\"color: rgb(33, 37, 41);\">Option 2) + and ×</p>\n\n<p style=\"color: rgb(33, 37, 41);\">20 / 5 + 10 - 4 × 2 = 38 ⇒ 20 / 5 × 10 - 4 + 2 = 38</p>\n\n<p style=\"color: rgb(33, 37, 41);\">⇒ <u><span style=\"font-weight: bolder;\">20 / 5</span></u> × 10 - 4 + 2 = 38 ⇒ <u><span style=\"font-weight: bolder;\">4 ×</span></u><u><span style=\"font-weight: bolder;\"> 10</span></u> - 4 + 2 = 38 ⇒ <u><span style=\"font-weight: bolder;\">40 + 2</span></u> - 4 = 38 ⇒ <u><span style=\"font-weight: bolder;\">42</span></u><u><span style=\"font-weight: bolder;\"> - 4</span></u> = 38 ⇒ <span style=\"font-weight: bolder;\">38 <span style=\"color: rgb(32, 33, 36);\">= 38</span> (LHS <span style=\"color: rgb(32, 33, 36);\">= </span>RHS)</span></p>\n",
      "images": [],
