        },
        {
          "id": "B",
          "text": "2 + 3 = 5",
          "html": "2 + 3 = 5"
        },
        {
          "id": "C",
          "text": "1 + 1 = 2",
          "html": "1 + 1 = 2"
        },
        {
          "id": "D",
          "text": "3 + 3 = 7",
          "html": "3 + 3 = 7"
        }
      ],
      "correctAnswer": "D",
      "solution": "<p style=\"color: rgb(33, 37, 41);\">6 + 7 = 13</p>\n\n<p style=\"color: rgb(33, 37, 41);\">13 = 13 (LHS = RHS)</p>\n\n<p style=\"color: rgb(33, 37, 41);\">2 + 3 = 5</p>\n\n<p style=\"color: rgb(33, 37, 41);\">5 = 5 (LHS = RHS)</p>\n\n<p style=\"color: rgb(33, 37, 41);\">Option 4) 3 + 3 = 7</p>\n\n<p style=\"color: rgb(33, 37, 41);\"><span style=\"font-weight: bolder;\">6 ≠ 7 (LHS ≠ RHS)</span></p>\n",
