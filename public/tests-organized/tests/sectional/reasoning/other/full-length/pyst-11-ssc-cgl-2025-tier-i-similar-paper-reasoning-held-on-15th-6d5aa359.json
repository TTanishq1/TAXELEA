      "solution": "<p style=\"color: rgb(33, 37, 41);\"><span style=\"font-weight: bolder;\">Option 2) 28 ÷ 4 - 4 + 8 = 36</span></p>\n\n<p style=\"color: rgb(33, 37, 41);\"><span style=\"font-weight: bolder;\">⇒ <span class=\"math-inline\" data-index-in-node=\"12\" data-math=\"28 + 4 \\times 4 - 8\" style=\"line-height: 1.15 !important; margin-top: 0px !important;\">28 + 4 </span>×<span class=\"math-inline\" data-index-in-node=\"12\" data-math=\"28 + 4 \\times 4 - 8\" style=\"line-height: 1.15 !important; margin-top: 0px !important;\"> 4 - 8</span><span class=\"base\"><span class=\"mrel\">=</span><span class=\"mclose\">?</span></span></span></p>\n\n<p style=\"color: rgb(33, 37, 41);\"><span style=\"font-weight: bolder;\">⇒ <span class=\"math-inline\" data-index-in-node=\"12\" data-math=\"28 + 4 \\times 4 - 8\" style=\"line-height: 1.15 !important; margin-top: 0px !important;\">28 + 16</span><span class=\"math-inline\" data-index-in-node=\"12\" data-math=\"28 + 4 \\times 4 - 8\" style=\"line-height: 1.15 !important; margin-top: 0px !important;\"> - 8</span><span class=\"base\"><span class=\"mrel\">=</span><span class=\"mclose\">?</span></span></span></p>\n\n<p style=\"color: rgb(33, 37, 41);\"><span style=\"font-weight: bolder;\">⇒ <span class=\"math-inline\" data-index-in-node=\"12\" data-math=\"28 + 4 \\times 4 - 8\" style=\"line-height: 1.15 !important; margin-top: 0px !important;\">44</span><span class=\"math-inline\" data-index-in-node=\"12\" data-math=\"28 + 4 \\times 4 - 8\" style=\"line-height: 1.15 !important; margin-top: 0px !important;\"> - 8</span><span class=\"base\"><span class=\"mrel\">= </span><span class=\"mclose\">36 </span></span></span></p>\n",
