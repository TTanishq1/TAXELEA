      "number": 23,
      "question": "If x+2y=14 and x-y=5, find x.",
      "questionHtml": "If x+2y=14 and x-y=5, find x.",
      "options": [
        {
          "id": "A",
          "text": "6",
          "html": "6"
        },
        {
          "id": "B",
          "text": "4",
          "html": "4"
        },
        {
          "id": "C",
          "text": "8",
          "html": "8"
        },
        {
          "id": "D",
          "text": "10",
          "html": "10"
        }
      ],
      "correctAnswer": "C",
      "solution": "<p data-end=\"132\" data-start=\"77\" style=\"color: rgb(33, 37, 41);\">Given:</p>\n\n<p data-end=\"132\" data-start=\"77\" style=\"color: rgb(33, 37, 41);\"><span style=\"color: rgb(33, 37, 41);\">x + 2y = 14</span><br data-end=\"23\" data-start=\"20\" style=\"color: rgb(33, 37, 41);\" />\n<span style=\"color: rgb(33, 37, 41);\">x − y = 5</span></p>\n\n<p data-end=\"132\" data-start=\"77\" style=\"color: rgb(33, 37, 41);\">5 + y + 2y = 14</p>\n\n<p data-end=\"147\" data-start=\"134\" style=\"color: rgb(33, 37, 41);\">5 + 3y = 14</p>\n\n<p data-end=\"157\" data-start=\"149\" style=\"color: rgb(33, 37, 41);\">3y = 9</p>\n\n<p data-end=\"166\" data-start=\"159\" style=\"color: rgb(33, 37, 41);\">y = 3</p>\n\n<p data-end=\"210\" data-start=\"168\" style=\"color: rgb(33, 37, 41);\">Now substitute back:<br data-end=\"191\" data-start=\"188\" />\nx = 5 + 3<br data-end=\"203\" data-start=\"200\" />\nx = 8</p>\n",
      "images": [],
      "subject": null,
      "topic": null,
      "difficulty": null
