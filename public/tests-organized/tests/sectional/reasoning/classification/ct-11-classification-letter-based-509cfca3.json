      "options": [
        {
          "id": "A",
          "text": "MPT : JRS",
          "html": "<span style=\"\">MPT : JRS</span>"
        },
        {
          "id": "B",
          "text": "PJQ : MGP",
          "html": "<span style=\"\">PJQ : MGP</span>"
