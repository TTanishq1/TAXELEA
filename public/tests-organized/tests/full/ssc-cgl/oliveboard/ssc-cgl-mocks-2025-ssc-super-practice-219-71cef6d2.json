        {
          "id": "B",
          "text": "Palas &#2346;&#2366;&#2354;",
          "html": "<span class=\"eqt\">Palas</span><span class=\"hqt\" style=\"display:none\">&#2346;&#2366;&#2354;</span>"
        },
        {
          "id": "C",
          "text": "Bundelas &#2348;&#2369;&#2306;&#2342;&#2375;&#2354;",
          "html": "<span class=\"eqt\">Bundelas</span><span class=\"hqt\" style=\"display:none\">&#2348;&#2369;&#2306;&#2342;&#2375;&#2354;</span>"
        },
        {
          "id": "D",
