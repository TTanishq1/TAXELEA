        },
        {
          "id": "D",
          "text": "Pallava &#2346;&#2354;&#2381;&#2354;&#2357;",
          "html": "<span class=\"eqt\">Pallava</span><span class=\"hqt\" style=\"display:none\">&#2346;&#2354;&#2381;&#2354;&#2357;</span>"
        }
