        {
          "id": "B",
          "text": "1598 1598",
          "html": "<span class=\"eqt\">1598</span><span class=\"hqt\" style=\"display:none\">1598</span>"
        },
        {
          "id": "C",
          "text": "1627 1627",
          "html": "<span class=\"eqt\">1627</span><span class=\"hqt\" style=\"display:none\">1627</span>"
        },
        {
          "id": "D",
          "text": "1823 1823",
          "html": "<span class=\"eqt\">1823</span><span class=\"hqt\" style=\"display:none\">1823</span>"
