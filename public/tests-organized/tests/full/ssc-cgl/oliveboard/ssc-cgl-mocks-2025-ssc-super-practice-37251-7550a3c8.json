      "question": "Express 7.6 into fractional form. 7.6 &#2325;&#2379; &#2349;&#2367;&#2344;&#2381;&#2344;&#2366;&#2340;&#2381;&#2350;&#2325; &#2352;&#2370;&#2346; &#2350;&#2375;&#2306; &#2357;&#2381;&#2351;&#2325;&#2381;&#2340; &#2325;&#2352;&#2375;&#2306;&#2404;",
      "questionHtml": "<span class=\"eqt\"><p>Express 7.6<img width=12 height=20 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p6668/image007.png\"> into fractional form.</p></span><span class=\"hqt\" style=\"display:none\"><p>7.6<img width=12 height=20 src=\"https://u1.oliveboard.in/exams/solution/oliveimg/p6668/image007.png\"> &#2325;&#2379; &#2349;&#2367;&#2344;&#2381;&#2344;&#2366;&#2340;&#2381;&#2350;&#2325; &#2352;&#2370;&#2346; &#2350;&#2375;&#2306; &#2357;&#2381;&#2351;&#2325;&#2381;&#2340; &#2325;&#2352;&#2375;&#2306;&#2404;</p></span>",
      "options": [
        {
          "id": "A",
          "text": "7(52/495) 7(52/495)",
          "html": "<span class=\"eqt\">7(52/495)</span><span class=\"hqt\" style=\"display:none\">7(52/495)</span>"
        },
        {
          "id": "B",
          "text": "7(53/164) 7(53/164)",
          "html": "<span class=\"eqt\">7(53/164)</span><span class=\"hqt\" style=\"display:none\">7(53/164)</span>"
        },
        {
          "id": "C",
          "text": "7(308/495) 7(308/495)",
          "html": "<span class=\"eqt\">7(308/495)</span><span class=\"hqt\" style=\"display:none\">7(308/495)</span>"
        },
        {
          "id": "D",
          "text": "7(308/164) 7(308/164)",
          "html": "<span class=\"eqt\">7(308/164)</span><span class=\"hqt\" style=\"display:none\">7(308/164)</span>"
        }
