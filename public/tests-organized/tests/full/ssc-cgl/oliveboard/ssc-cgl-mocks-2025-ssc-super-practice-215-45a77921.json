        },
        {
          "id": "C",
          "text": "4 October 4 &#2309;&#2325;&#2381;&#2335;&#2370;&#2348;&#2352;",
          "html": "<span class=\"eqt\">4 October</span><span class=\"hqt\" style=\"display:none\">4 &#2309;&#2325;&#2381;&#2335;&#2370;&#2348;&#2352;</span>"
