    {
      "id": "37f44dd3bf4c-q2",
      "number": 2,
      "question": "Find the unit digit in (423) 75 X (867) 54 + (295) 63 X (712) 91 . (423) 75 X (867) 54 + (295) 63 X (712) 91 &#2350;&#2375;&#2306; &#2311;&#2325;&#2366;&#2312; &#2309;&#2306;&#2325; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;",
      "questionHtml": "<span class=\"eqt\"><p>Find the unit digit in (423)<sup>75</sup>  X  (867)<sup>54</sup> + (295)<sup>63</sup>  X  (712)<sup>91</sup>.</p></span><span class=\"hqt\" style=\"display:none\"><p>(423)<sup>75</sup> X (867)<sup>54</sup> + (295)<sup>63</sup> X (712)<sup>91</sup> &#2350;&#2375;&#2306; &#2311;&#2325;&#2366;&#2312; &#2309;&#2306;&#2325; &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p></span>",
      "options": [
        {
