      "questionHtml": "<p>Count the number of squares in the given figure.</p>\n\n<p><img alt=\"\" src=\"https://storage.googleapis.com/tb-img/production/22/04/F4_Savita_SSC_28-4-22_D1.png\" style=\"width: 117px; height: 117px;\" /></p>\n",
