      "number": 16,
      "question": "Select the number that will come in the place of the question mark(?), if '+' and '&minus;' are interchanged and '&times;' and '&divide;' are interchanged 63 &times; 7 &divide; 13 &minus; 64 + 42 = ?",
      "questionHtml": "Select the number that will come in the place of the question mark(?), if &#39;+&#39; and &#39;&minus;&#39; are interchanged and &#39;&times;&#39; and &#39;&divide;&#39; are interchanged<br />\n63 &times; 7 &divide; 13 &minus; 64 + 42 = ?",
      "options": [
        {
          "id": "A",
          "text": "144",
          "html": "144"
        },
        {
          "id": "B",
          "text": "131",
