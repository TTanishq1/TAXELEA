        {
          "id": "C",
          "text": "16",
          "html": "16"
        },
        {
          "id": "D",
          "text": "10",
          "html": "10"
        }
      ],
      "correctAnswer": "C",
      "solution": "<p><span style=\"color: rgb(33, 37, 41);\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\"><span style=\"font-weight: bolder;\">Logic:</span> </span></span><span style=\"color: rgb(33, 37, 41);\">a @ b = (a ÷ b)ᵇ</span></p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\">8 @ 4 = ?</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\">8 ÷ 4 = 2 → 2<span style=\"position: relative; line-height: 0; vertical-align: baseline; top: -0.5em; font-size:10.5px;\">4</span> = 16</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\">So, 16 will come in the place of ?</p>\n",
      "images": [],
