    {
      "id": "a9b6260c0e6f-q3",
      "number": 3,
      "question": "Choose the correct signs to swap. 40 &divide; 8 + 10 - 5 &times; 2 = 5",
      "questionHtml": "<p>Choose the correct signs to swap.</p>\n\n<p>40 &divide; 8 + 10 - 5 &times; 2 = 5</p>\n",
      "options": [
        {
          "id": "A",
          "text": "&divide; and &times;",
          "html": "&divide; and &times;"
        },
        {
          "id": "B",
          "text": "+ and -",
          "html": "+ and -"
        },
        {
          "id": "C",
          "text": "&divide; and +",
          "html": "&divide; and +"
        },
        {
          "id": "D",
          "text": "- and &times;",
          "html": "- and &times;"
        }
      ],
      "correctAnswer": "B",
      "solution": "<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\">2. + and -</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span id=\"docs-internal-guid-75b2307f-7fff-ffbe-de3b-33565cfb92df\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\">Given equation: </span></span>40 ÷ 8 + 10 - 5 × 2 = 5</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span style=\"background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\">After interchanging the signs we get;</span></p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span id=\"docs-internal-guid-91a1311b-7fff-0cec-7181-c356cf2a3e0a\"><span style=\"background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\">⇒ </span></span><u><span style=\"font-weight: bolder;\">40 ÷ 8</span></u> − 10 + 5 × 2 = 5</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span id=\"docs-internal-guid-91a1311b-7fff-0cec-7181-c356cf2a3e0a\"><span style=\"background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\">⇒ 5</span></span> − 10 + <u><span style=\"font-weight: bolder;\">5 × 2</span></u> = 5</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span id=\"docs-internal-guid-91a1311b-7fff-0cec-7181-c356cf2a3e0a\"><span style=\"background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\">⇒ <u><span style=\"font-weight: bolder;\">5</span></u></span></span> − 10 <u><span style=\"font-weight: bolder;\">+ 10</span></u> = 5</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span id=\"docs-internal-guid-91a1311b-7fff-0cec-7181-c356cf2a3e0a\"><span style=\"background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\">⇒ <u><span style=\"font-weight: bolder;\">15</span></u></span></span><u><span style=\"font-weight: bolder;\"> − 10</span></u> = 5</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span id=\"docs-internal-guid-91a1311b-7fff-0cec-7181-c356cf2a3e0a\"><span style=\"background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;\">⇒ 5</span></span> = 5</p>\n\n<p dir=\"ltr\" style=\"margin-top: 0pt; margin-bottom: 12pt; line-height: 1.38;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; white-space-collapse: preserve; background-color: transparent; vertical-align: baseline;\">⇒ </span><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; white-space-collapse: preserve; background-color: transparent; vertical-align: baseline;\">LHS = RHS</span></p>\n",
