      "question": "If 6 @ 2 = 9, 15 @ 3 = 125, then 8 @ 4 = ?",
      "questionHtml": "If 6 @ 2 = 9, 15 @ 3 = 125, then 8 @ 4 = ?",
      "options": [
        {
          "id": "A",
          "text": "4",
          "html": "4"
        },
        {
          "id": "B",
          "text": "8",
