      "questionHtml": "<span class=\"eqt\"><p>Find the missing term (?) in the following series.</p><p>4, 14, 44, 134, 404, ?</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2344;&#2367;&#2350;&#2381;&#2344;&#2354;&#2367;&#2326;&#2367;&#2340; &#2358;&#2371;&#2306;&#2326;&#2354;&#2366; &#2350;&#2375;&#2306; &#2354;&#2369;&#2346;&#2381;&#2340; &#2346;&#2342; (?) &#2332;&#2381;&#2334;&#2366;&#2340; &#2325;&#2368;&#2332;&#2367;&#2319;&#2404;</p><p>4, 14, 44, 134, 404, ?</p></span>",
