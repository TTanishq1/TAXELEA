      "questionHtml": "<span class=\"eqt\"><p>The temple at Khajuraho were built during which dynasty?</p></span><span class=\"hqt\" style=\"display:none\"><p>&#2326;&#2332;&#2369;&#2352;&#2366;&#2361;&#2379; &#2325;&#2366; &#2350;&#2306;&#2342;&#2367;&#2352; &#2325;&#2367;&#2360; &#2352;&#2366;&#2332;&#2357;&#2306;&#2358; &#2325;&#2375; &#2360;&#2350;&#2351; &#2348;&#2344;&#2366;&#2319; &#2327;&#2319; &#2341;&#2375;?</p></span>",
      "options": [
        {
          "id": "A",
          "text": "Maurya dynasty &#2350;&#2380;&#2352;&#2381;&#2351; &#2352;&#2366;&#2332;&#2357;&#2306;&#2358;",
